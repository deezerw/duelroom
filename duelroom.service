[Unit]
Description=duelroom deck lab (tmux session 'duelroom': gunicorn TLS :8446 + job worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=deezer
Group=deezer
WorkingDirectory=/home/deezer/duelroom
ExecStart=/home/deezer/duelroom/tmux-start.sh
ExecStop=/home/deezer/duelroom/tmux-stop.sh
KillMode=process
# A solver job can run for hours; the stop script asks the worker to finish
# the one it holds. Give it room rather than leaving a half-written sweep.
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
