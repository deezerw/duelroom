[Unit]
Description=duelroom deck lab (tmux session 'duelroom': gunicorn TLS :8446 + job worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=deezer
Group=deezer
WorkingDirectory=/home/deezer/duelroom
ExecStart=/home/deezer/duelroom/tmux-start.sh
ExecStop=/home/deezer/duelroom/tmux-stop.sh
KillMode=process
# The stop script gives the worker DUELROOM_STOP_GRACE (default 180s) to
# finish the job it holds; systemd must outlast that or it SIGKILLs the lot
# and the grace period is theatre.
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
