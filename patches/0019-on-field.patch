diff -ruN combo-solver-rooted/solver-patched/search.cpp combo-solver-next/solver-patched/search.cpp
--- combo-solver-rooted/solver-patched/search.cpp	2026-11-26 00:54:27.451823344 -0500
+++ combo-solver-next/solver-patched/search.cpp	2026-11-26 18:17:04.009822243 -0500
@@ -1839,11 +1839,22 @@
 
 bool Search::ActivationLive(uint32_t code) {
 	const uint32_t c = duel.Db().Canonical(code);
+	Duel::ChainLink l{};
+	const uint8_t who = static_cast<uint8_t>(cfg.target_player);
+	// Patch 0019: Ghost Ogre destroys "that card on the field" -- wasted on a card that left
+	// as its own cost (Fiendsmith's Requiem tributes itself: 9 of 11 Ogres stopped nothing,
+	// tools/experiments/wasted_answers.py). Answer only a card activated on the field that is
+	// still there face-up: a monster OR a face-up Spell / Trap (Perlereino is a real stop).
+	if(std::find(cfg.opp_on_field.begin(), cfg.opp_on_field.end(), c) != cfg.opp_on_field.end()) {
+		if(duel.ChainLinkFromEnd(0, &l) && l.trig_con == who && (l.trig_loc & LOCATION_ONFIELD) &&
+		   l.con == who && (l.loc & LOCATION_ONFIELD) && (l.pos & POS_FACEUP))
+			return true;
+		++stats.activation_holds;
+		return false;
+	}
 	if(std::find(cfg.opp_on_activation.begin(), cfg.opp_on_activation.end(), c) ==
 	   cfg.opp_on_activation.end())
 		return true;
-	Duel::ChainLink l{};
-	const uint8_t who = static_cast<uint8_t>(cfg.target_player);
 	if(duel.ChainLinkFromEnd(0, &l) && l.trig_con == who && (l.trig_loc & LOCATION_MZONE) &&
 	   l.con == who && (l.loc & LOCATION_MZONE) && (l.pos & POS_FACEUP))
 		return true;
