+// "60 s" search a fraction of 60 s of work, so results depended on what else ran.
+// On an idle machine the two advance together: an idle run is unchanged.
+struct ThreadWorkClock {
+	using duration = std::chrono::nanoseconds;
+	using rep = duration::rep;
+	using period = duration::period;
+	using time_point = std::chrono::time_point<ThreadWorkClock>;
+	static constexpr bool is_steady = true;
+	static time_point now() noexcept {
+		timespec ts{};
+		clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+		return time_point(duration(static_cast<rep>(ts.tv_sec) * 1000000000LL + ts.tv_nsec));
+	}
+};
