+#if defined(R2V_UFFD)
+size_t Arena::UffdCollect(std::vector<uint64_t>* bits) {
+	// /proc/self/pagemap, once per process: PAGEMAP_SCAN is an ioctl on it.
+	static const int pagemap = open("/proc/self/pagemap", O_RDONLY | O_CLOEXEC);
+	if(pagemap < 0) {
+		// Cannot read the marks: everything committed is dirty (correct, slow).
+		if(bits)
+			std::fill(bits->begin(), bits->end(), ~uint64_t(0));
+		return committed / page_size + 1;
+	}
+	page_region regions[256];
+	pm_scan_arg arg{};
+	arg.size = sizeof(arg);
+	arg.flags = PM_SCAN_WP_MATCHING | PM_SCAN_CHECK_WPASYNC;
+	arg.end = base_addr + committed;
+	arg.vec = reinterpret_cast<std::uintptr_t>(regions);
+	arg.vec_len = sizeof(regions) / sizeof(regions[0]);
+	arg.category_mask = PAGE_IS_WRITTEN;
+	arg.return_mask = PAGE_IS_WRITTEN;
+	size_t count = 0;
+	for(std::uintptr_t at = base_addr; at < arg.end;) {
+		arg.start = at;
+		arg.walk_end = 0;
+		const long n = ioctl(pagemap, PAGEMAP_SCAN, &arg);
+		if(n < 0) {
+			// A failed scan may have re-armed part of the range already:
+			// over-mark everything, never under-mark.
+			if(bits)
+				std::fill(bits->begin(), bits->end(), ~uint64_t(0));
+			return committed / page_size + 1;
+		}
+		for(long i = 0; i < n; ++i) {
+			const size_t p0 = (regions[i].start - base_addr) / page_size;
+			const size_t p1 = (regions[i].end - base_addr) / page_size;
+			count += p1 - p0;
+			if(bits)
+				for(size_t p = p0; p < p1; ++p)
+					(*bits)[p >> 6] |= uint64_t(1) << (p & 63);
+		}
+		// walk_end < end only when the region buffer filled up.
+		if(arg.walk_end <= at)
+			break;
+		at = arg.walk_end;
+	}
+	return count;
+}
