+int Search::DefenderRank(uint32_t code) const {
+	if(cfg.opp_respond.empty())
+		return 0;
+	for(size_t i = 0; i < cfg.opp_respond.size(); ++i)
+		if(cfg.opp_respond[i] == code)
+			return static_cast<int>(i);
+	return -1;
+}
+
+size_t Search::DefenderPick(const ChoiceList& out) {
+	// Only the card-selection prompts carry a choice worth weighing; every
+	// other follow-up keeps the first legal answer (yes, the first zone...).
+	if(prompt_type != MSG_SELECT_CARD && prompt_type != MSG_SELECT_TRIBUTE &&
+	   prompt_type != MSG_SELECT_UNSELECT_CARD)
+		return 0;
+	const uint8_t* d = prompt_payload.data();
+	const size_t n = prompt_payload.size();
+	size_t off = 0;
+	auto u8 = [&](uint8_t& v) {
+		if(off + 1 > n) return false;
+		v = d[off]; off += 1; return true;
+	};
+	auto u32 = [&](uint32_t& v) {
+		if(off + 4 > n) return false;
+		std::memcpy(&v, d + off, 4); off += 4; return true;
+	};
+	// Header: player, cancelable[, finishable], min, max, count -- the same
+	// layouts enumerate.cpp reads (MSG_SELECT_CARD / TRIBUTE / UNSELECT_CARD).
+	uint8_t b = 0;
+	uint32_t w = 0, count = 0;
+	if(!u8(b) || !u8(b)) return 0;
+	if(prompt_type == MSG_SELECT_UNSELECT_CARD && !u8(b)) return 0;
+	if(!u32(w) || !u32(w) || !u32(count)) return 0;
+	struct Cand { uint8_t con, loc; uint32_t seq; };
+	std::vector<Cand> cands;
+	cands.reserve(count);
+	for(uint32_t i = 0; i < count; ++i) {
+		Cand c{};
+		uint32_t code = 0;
+		if(!u32(code) || !u8(c.con) || !u8(c.loc) || !u32(c.seq)) return 0;
+		if(prompt_type == MSG_SELECT_TRIBUTE) { if(!u8(b)) return 0; }
+		else if(!u32(w)) return 0;          // position
+		cands.push_back(c);
+	}
+	// Value of each candidate to the DEFENDER: giving up its own card costs
+	// that card's ATK, taking the attacker's card is worth that card's ATK.
+	// Off the field a card has no ATK that matters: ties keep the first.
+	std::vector<int64_t> val(cands.size(), 0);
+	std::vector<QueriedCard> q;
+	for(size_t i = 0; i < cands.size(); ++i) {
+		int64_t atk = 0;
+		if(cands[i].loc & LOCATION_ONFIELD) {
+			duel.Query(cands[i].con, cands[i].loc, QUERY_CODE | QUERY_ATTACK, q);
+			if(cands[i].seq < q.size() && q[cands[i].seq].present)
+				atk = std::max<int32_t>(0, q[cands[i].seq].attack);
+		}
+		val[i] = (cands[i].con == prompt_player) ? -(atk + 1) : (atk + 1);
+	}
+	size_t best = 0;
+	int64_t best_v = 0;
+	bool any = false;
+	for(size_t i = 0; i < out.size(); ++i) {
+		const auto& r = out.At(i).response;
+		if(r.size() < 8)
+			continue;           // cancel / finish (-1): never by choice
+		int32_t type = 0;
+		std::memcpy(&type, r.data(), 4);
+		int64_t v = 0;
+		bool ok = false;
+		if(prompt_type == MSG_SELECT_UNSELECT_CARD) {
+			if(type != 1) continue;
+			int32_t ix = 0;
+			std::memcpy(&ix, r.data() + 4, 4);
+			if(ix < 0 || static_cast<size_t>(ix) >= val.size())
+				continue;       // a deselect
+			v = val[static_cast<size_t>(ix)];
+			ok = true;
+		} else {
+			if(type != 2) continue;
+			uint32_t k = 0;
+			std::memcpy(&k, r.data() + 4, 4);
+			if(r.size() < 8 + static_cast<size_t>(k)) continue;
+			for(uint32_t j = 0; j < k; ++j) {
+				const uint8_t ix = r[8 + j];
+				if(ix < val.size()) { v += val[ix]; ok = true; }
+			}
+		}
+		if(ok && (!any || v > best_v)) {
+			any = true;
+			best_v = v;
+			best = i;
+		}
+	}
+	return any ? best : 0;
+}
