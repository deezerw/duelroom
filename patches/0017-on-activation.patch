+bool Duel::ChainLinkFromEnd(uint32_t k, ChainLink* out) {
+	uint32_t n = 0;
+	if(!LastChainLink(nullptr, &n) || k >= n)
+		return false;
+	uint32_t len = 0;
+	const uint8_t* data = nullptr;
+	{
+		ArenaScope scope(arena);
+		data = static_cast<const uint8_t*>(OCG_DuelQueryField(handle, &len));
+	}
+	// The chain closes the buffer: u32 count, then per link code u32, controller
+	// u8, location u8, sequence u32, position u32, triggering controller u8,
+	// location u8, sequence u32, description u64 (ocgapi.cpp).
+	constexpr uint32_t kLink = 4 + 1 + 1 + 4 + 4 + 1 + 1 + 4 + 8;
+	if(!data || len < n * kLink + 4)
+		return false;
+	uint32_t stored = 0;
+	std::memcpy(&stored, data + len - n * kLink - 4, 4);
+	if(stored != n)
+		return false;           // the layout moved: answer nothing rather than misread
+	const uint8_t* l = data + len - (k + 1) * kLink;
+	std::memcpy(&out->code, l, 4);
+	out->con = l[4];
+	out->loc = l[5];
+	std::memcpy(&out->seq, l + 6, 4);
+	std::memcpy(&out->pos, l + 10, 4);
+	out->trig_con = l[14];
+	out->trig_loc = l[15];
+	std::memcpy(&out->trig_seq, l + 16, 4);
+	return true;
+}
