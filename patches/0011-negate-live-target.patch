+bool Search::NegateLive(uint32_t code) {
+	const uint32_t c = duel.Db().Canonical(code);
+	const bool any = std::find(cfg.opp_negate.begin(), cfg.opp_negate.end(), c) !=
+					 cfg.opp_negate.end();
+	const bool mon = std::find(cfg.opp_negate_mon.begin(), cfg.opp_negate_mon.end(), c) !=
+					 cfg.opp_negate_mon.end();
+	if(!any && !mon)
+		return true;
+	std::vector<QueriedCard> q;
+	const uint8_t who = static_cast<uint8_t>(cfg.target_player);
+	for(uint32_t loc : { (uint32_t)LOCATION_MZONE, (uint32_t)LOCATION_SZONE }) {
+		if(loc == LOCATION_SZONE && !any)
+			break;
+		duel.Query(who, loc, QUERY_CODE | QUERY_ALIAS | QUERY_POSITION, q);
+		for(const QueriedCard& k : q)
+			if(k.present && (k.position & POS_FACEUP) &&
+			   std::find(cfg.opp_dead.begin(), cfg.opp_dead.end(),
+						 duel.Db().Canonical(k.Code())) == cfg.opp_dead.end())
+				return true;
+	}
+	++stats.negate_holds;
+	return false;
+}
