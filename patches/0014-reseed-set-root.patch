+				fld->remove_card(c);
+				if(!ExecLua("Debug.AddCard(" + std::to_string(yrp.root_set_card) + "," +
+							std::to_string(t) + "," + std::to_string(t) + ",LOCATION_SZONE," +
+							std::to_string(seq) + ",POS_FACEDOWN)", "opp_set_root")) {
+					error = "--opp-set-root: Debug.AddCard failed";
+					return false;
+				}
+			}
+		}
+		if(yrp.root_reseed) {
+			uint64_t z = yrp.root_reseed;
+			auto mix = [&z]() {                 // splitmix64: four words of state from one seed
+				z += 0x9E3779B97F4A7C15ULL;
+				uint64_t x = z;
+				x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+				x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+				return x ^ (x >> 31);
+			};
+			pd->*get(DuelRandom{}) = RNG::Xoshiro256StarStar({mix(), mix(), mix(), mix()});
+			for(uint8_t p = 0; p < 2; ++p)
+				fld->shuffle(p, LOCATION_DECK);
+		}
+	}
