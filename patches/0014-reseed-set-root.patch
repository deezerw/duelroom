 #include "duel.h"
+// The core's own duel / field (patch 0014: reseed and set-card swap at the root).
+// Quoted relative includes resolve next to the including file, so these are
+// ocgcore's, never this directory's duel.h.
+#include "../ocgcore/duel.h"
+#include "../ocgcore/field.h"
+#include "../ocgcore/card.h"
+
+namespace {
+// duel::random is private and the core has no reseed: an explicit template
+// instantiation may name a private member (the standard "member pointer through
+// instantiation" rule), so the patch reaches it without editing the pinned core.
+template <typename Tag, typename Tag::type M> struct Rob {
+	friend typename Tag::type get(Tag) { return M; }
+};
+using CoreRng = RNG::Xoshiro256StarStar;
+struct DuelRandom {
+	using type = CoreRng duel::*;
+	friend type get(DuelRandom);
+};
+template struct Rob<DuelRandom, &duel::random>;
+}
 
