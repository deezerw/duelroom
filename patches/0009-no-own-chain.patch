+void Search::NoOwnChain(ChoiceList& out) {
+	const Choice& last = out[out.size() - 1];
+	const bool declinable =
+		last.response.size() == 4 && last.response[0] == 0xff &&
+		last.response[1] == 0xff && last.response[2] == 0xff &&
+		last.response[3] == 0xff;
+	if(!declinable)
+		return;
+	for(size_t i = out.size() - 1; i-- > 0;) {
+		const uint32_t code = out[i].card;
+		if(code && std::find(cfg.no_own_chain.begin(), cfg.no_own_chain.end(),
+							 duel.Db().Canonical(code)) != cfg.no_own_chain.end()) {
+			out.RemoveAt(i);
+			++stats.own_chain_cuts;
+		}
+	}
+}
 
