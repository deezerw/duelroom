+Search::PrefixReplay Search::ReplayPrefix(
+	const std::vector<std::vector<uint8_t>>& pre, bool line) {
+	PrefixReplay r;
+	ChoiceList out;
+	// A line recorded against a passive opponent never saw a chain window
+	// that the opponent's own activation opens: the window to respond to
+	// their link, and the window re-offered once a chain made of their links
+	// alone has resolved. Those are UNPLANNED: declined without consuming an
+	// answer (a recorded decline fits any window, so consuming one would
+	// shift the whole line by one). Everything else is fed as recorded, and
+	// the first refusal is where the line diverged. No arena snapshot is
+	// taken here: a nested level dropped without restoring (Discard) leaves
+	// the parent's undo log blind to its pages, and the finisher restores
+	// that parent level -- measured as a segfault.
+	//
+	// Verified 2026-11-14 (imported hand 2, 148 answers): against the
+	// trainer's passive deck every answer holds; against Angelechy-Meta the
+	// line holds 70, then a card of theirs our Pilgrim Reaper milled gives
+	// them a trigger the defender takes, and the game has changed.
+	static const std::vector<uint8_t> kDecline{ 0xff, 0xff, 0xff, 0xff };
+	static const bool debug = std::getenv("R2V_DEBUG_PREFIX") != nullptr;
+	bool chain_ours = false, chain_theirs = false;   // links of the chain building / just resolved
+	bool was_building = false;
+	for(;;) {
+		// Same contract as the finisher's byte replay: the last answer is fed
+		// and left pending for the search that follows, not processed here.
+		if(r.used == pre.size()) {
+			r.ok = true;
+			return r;
+		}
+		const Step s = StepToPrompt();
+		r.actions += actions_this_step;
+		r.turns += turns_this_step;
+		r.summons += static_cast<uint32_t>(summons_this_step.size());
+		r.resolved += resolved_this_step;
+		if(s == Step::Rejected) {
+			if(r.used)
+				--r.used;   // pre[used] is the answer that was refused
+			if(!r.fed.empty())
+				r.fed.pop_back();
+			r.refused = true;
+			if(debug)
+				std::fprintf(stderr, "[prefix] diverged after %zu own answers "
+									 "(%zu fed), prompt type %u player %d\n",
+							 r.used, r.fed.size(), prompt_type, prompt_player);
+			return r;
+		}
+		if(s == Step::Ended)
+			return r;
+		bool unplanned = false;
+		if(line && prompt_type == MSG_SELECT_CHAIN) {
+			uint8_t lp = 255;
+			const bool building = duel.LastChainLink(&lp);
+			if(building) {
+				if(!was_building)
+					chain_ours = chain_theirs = false;   // a new chain
+				if(lp == cfg.target_player)
+					chain_ours = true;
+				else
+					chain_theirs = true;
+				unplanned = lp != cfg.target_player;
+			} else {
+				unplanned = chain_theirs && !chain_ours;   // re-offer after their chain alone
+			}
+			was_building = building;
+		} else if(line) {
+			chain_ours = chain_theirs = false;
+			was_building = false;
+		}
+		if(line && prompt_player != cfg.target_player) {
+			out.Clear();
+			if(!FillChoices(out) || out.empty())
+				return r;
+			duel.SetResponse(out.At(0).response);
+			r.fed.push_back(out.At(0).response);
+			continue;
+		}
+		if(unplanned) {
+			duel.SetResponse(kDecline);
+			r.fed.push_back(kDecline);
+			continue;
+		}
+		duel.SetResponse(pre[r.used]);
+		r.fed.push_back(pre[r.used]);
+		++r.used;
+	}
+}
