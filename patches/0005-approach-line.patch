--- a/solver-patched/search.h	2026-11-13 15:40:19.961597466 -0500
+++ b/solver-patched/search.h	2026-11-13 19:54:01.323365790 -0500
@@ -3382,6 +3382,26 @@
 	// the corpus agreement curve is blind to Q^. Empty when --qhat is off.
 	std::vector<BanditProbe> RootBandit() const;
 
+	// duelroom patch 0005: replay recorded answers from the current state.
+	// With `line`, the answers are the TARGET player's only and the DEFENDER
+	// (cfg.opp_*) answers the other player's prompts exactly as it does in the
+	// search; the replay stops at the first answer the core refuses -- an
+	// interruption changed the prompts -- and says how far the line held.
+	// Without `line`, every prompt consumes an answer, byte for byte (an
+	// approach written by a run records both players). `fed` is everything
+	// actually answered, both players: what a line built on this prefix
+	// must carry to replay.
+	struct PrefixReplay {
+		size_t used = 0;
+		uint32_t actions = 0, summons = 0, turns = 0;
+		uint64_t resolved = 0;
+		bool ok = false;        // every answer consumed, none refused
+		bool refused = false;   // the last answer fed was refused (MSG_RETRY)
+		std::vector<std::vector<uint8_t>> fed;
+	};
+	PrefixReplay ReplayPrefix(const std::vector<std::vector<uint8_t>>& pre,
+							  bool line);
+
 private:
 	enum class Step { Prompt, Ended, Rejected };
 
