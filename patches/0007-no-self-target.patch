+void Search::NoSelfTarget(ChoiceList& out) {
+	uint8_t lp = 255;
+	if(!duel.LastChainLink(&lp) || lp != cfg.target_player)
+		return;
+	const uint32_t code = duel.Db().Canonical(duel.LastChainCode());
+	if(std::find(cfg.no_self_target.begin(), cfg.no_self_target.end(), code) ==
+	   cfg.no_self_target.end())
+		return;
+	// MSG_SELECT_CARD: player u8, cancelable u8, min u32, max u32, count u32,
+	// then per candidate code u32, controller u8, location u8, sequence u32,
+	// position u32 (the layout DefenderPick reads).
+	const uint8_t* d = prompt_payload.data();
+	const size_t n = prompt_payload.size();
+	size_t off = 2 + 4 + 4;
+	uint32_t count = 0;
+	if(off + 4 > n)
+		return;
+	std::memcpy(&count, d + off, 4);
+	off += 4;
+	std::vector<uint8_t> con;
+	for(uint32_t i = 0; i < count; ++i) {
+		if(off + 14 > n)
+			return;
+		con.push_back(d[off + 4]);
+		off += 14;
+	}
+	for(size_t i = out.size(); i-- > 0;) {
+		const auto& r = out.At(i).response;
+		int32_t type = 0;
+		if(r.size() < 8)
+			continue;
+		std::memcpy(&type, r.data(), 4);
+		if(type != 2)
+			continue;
+		uint32_t k = 0;
+		std::memcpy(&k, r.data() + 4, 4);
+		bool theirs = false;
+		for(uint32_t j = 0; j < k && 8 + j < r.size(); ++j)
+			theirs = theirs || (r[8 + j] < con.size() && con[r[8 + j]] != cfg.target_player);
+		if(!theirs) {
+			out.RemoveAt(i);
+			++stats.self_target_cuts;
+		}
+	}
+}
