# duelroom patch 0002 -- ROOTED SEARCH (`--root <prefix.yrp>`), STAGE9 Gate A.
#
# ISSUES.md #4: a search from a position a duel has already reached found
# nothing, because only the finisher ever saw the resumed root (no plan,
# probe or NRPA there). Three changes make every phase root there:
#
# 1. `--root`: the start replay carries the prefix (Replay::root_prefix);
#    Duel::Setup replays it right after the duel starts, leaving the last
#    answer pending exactly as the finisher's replay_prefix does. WriteYrp1
#    writes prefix + line, so every output replays from the duel's start.
# 2. Turn cuts count from the root: Search adds Duel::RootTurns() to
#    initial_turns; includes patch 0001's `turns >= 2` -> max_turns + 1.
# 3. A REAL BUG, not a feature: MSG_SELECT_PLACE answers named the zone
#    owner RELATIVE to the chooser where the core wants the ABSOLUTE player
#    (playerop.cpp:575). Harmless as player 0, a MSG_RETRY on every summon
#    as player 1 -- the second blocker patch 0001's note could not name
#    ("no extra-deck monster summoned").
#
# 4. `--goal-win`: a solution is a duel the target player WINS (MSG_WIN),
#    not a board. Every strategy's Step::Ended site records the win; the
#    writer's verification judges by the replay's winner.
# 5. A second real trap, found by STAGE9 Gate B: ocgcore does NOT stop at
#    MSG_WIN -- it keeps processing and only reports OCG_DUEL_STATUS_END when
#    its unit queue is empty (processor_visit.cpp). Under --goal-win a
#    decided duel now ends the step; otherwise no win was ever seen.
#
# Gates (tools/experiments/rooted_gate.py, lethal_gate.py), 2026-11-02:
#   A  kewl-tune, 8 hands, 60 s, empty field: going first 8/8, old
#      --approach turn 2 0/8, --root turn 2 8/8.
#   B  vanilla positions with a known answer: lethal and clear-then-lethal
#      found (5 and 8 lines, all replay to a win), both one-short positions
#      return nothing.
#
# Without --root/--goal-win the binary behaves as the pinned one for player 0.
# Built as a SEPARATE binary (tools/build_rooted_solver.sh); the pinned
# engine.SOLVER_BIN is untouched, so no measurement needs re-gating.
# Apply inside build/combo-solver-rooted/solver-patched with `patch -p2`.

diff -ru combo-solver/solver-patched/duel.cpp combo-solver-rooted/solver-patched/duel.cpp
--- combo-solver/solver-patched/duel.cpp	2026-10-17 19:22:43.000000000 -0400
+++ combo-solver-rooted/solver-patched/duel.cpp	2026-11-02 01:33:07.012096708 -0500
@@ -134,6 +134,7 @@
 		error = "the yrp1 does not contain two decks";
 		return false;
 	}
+	{
 	ArenaScope scope(arena);
 	for(uint8_t team = 0; team < 2; ++team) {
 		const Deck& deck = yrp.decks[team];
@@ -164,6 +165,32 @@
 		}
 	}
 	OCG_StartDuel(handle);
+	}
+	// Rooted search: replay the prefix and leave its LAST answer pending, the
+	// state the finisher's replay_prefix leaves an approach root in (the
+	// Search's first Process consumes it). Outside the scope above: Messages()
+	// allocates host memory, which must not land in the arena.
+	size_t used = 0;
+	while(used < yrp.root_prefix.size()) {
+		const int st = Process();
+		for(const Message& m : Messages()) {
+			if(m.type == MSG_NEW_TURN)
+				++root_turns;
+			if(m.type == MSG_RETRY) {
+				error = "--root: the core rejected answer " + std::to_string(used) +
+						" of the prefix (MSG_RETRY)";
+				return false;
+			}
+		}
+		if(st == OCG_DUEL_STATUS_AWAITING)
+			SetResponse(yrp.root_prefix[used++]);
+		else if(st != OCG_DUEL_STATUS_CONTINUE) {
+			error = "--root: the duel ended inside the prefix (" +
+					std::to_string(used) + "/" +
+					std::to_string(yrp.root_prefix.size()) + " answers)";
+			return false;
+		}
+	}
 	return true;
 }
 
