+uint32_t Duel::LastChainCode() {
+	if(!LastChainLink(nullptr))
+		return 0;
+	uint32_t len = 0;
+	const uint8_t* data = nullptr;
+	{
+		ArenaScope scope(arena);
+		data = static_cast<const uint8_t*>(OCG_DuelQueryField(handle, &len));
+	}
+	// Per link: code u32, controller u8, location u8, sequence u32, position
+	// u32, triggering controller u8, location u8, sequence u32, description
+	// u64 (ocgapi.cpp OCG_DuelQueryField).
+	constexpr uint32_t kLink = 4 + 1 + 1 + 4 + 4 + 1 + 1 + 4 + 8;
+	if(!data || len < kLink + 4)
+		return 0;
+	uint32_t code = 0;
+	std::memcpy(&code, data + len - kLink, 4);
+	return code;
+}
